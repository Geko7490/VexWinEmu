diff --git a/app/src/main/java/com/winlator/widget/DirectTouchInput.java b/app/src/main/java/com/winlator/widget/DirectTouchInput.java
new file mode 100644
index 0000000..ebe47f1
--- /dev/null
+++ b/app/src/main/java/com/winlator/widget/DirectTouchInput.java
@@ -0,0 +1,156 @@
+package com.winlator.widget;
+
+import android.view.MotionEvent;
+import android.view.ViewConfiguration;
+
+import com.winlator.xserver.Pointer;
+import com.winlator.xserver.XServer;
+
+final class DirectTouchInput {
+    private enum Gesture { IDLE, TAP, DRAG, SCROLL, CONSUMED }
+
+    private final TouchpadView view;
+    private final XServer server;
+    private final int touchSlop;
+    private final float scrollStep;
+    private final float[] desktopPoint = new float[2];
+    private final Runnable longPress = this::rightClick;
+    private Gesture gesture = Gesture.IDLE;
+    private int primaryId;
+    private int secondId;
+    private float startX;
+    private float startY;
+    private float lastScrollY;
+    private float scrollRemainder;
+    private boolean leftDown;
+
+    DirectTouchInput(TouchpadView view, XServer server) {
+        this.view = view;
+        this.server = server;
+        touchSlop = ViewConfiguration.get(view.getContext()).getScaledTouchSlop();
+        scrollStep = 32 * view.getResources().getDisplayMetrics().density;
+    }
+
+    void onTouch(MotionEvent event) {
+        int index = event.getActionIndex();
+        switch (event.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                cancel();
+                primaryId = event.getPointerId(index);
+                startX = event.getX(index);
+                startY = event.getY(index);
+                if (!view.mapDirectPoint(startX, startY, desktopPoint)) {
+                    gesture = Gesture.CONSUMED;
+                    break;
+                }
+                gesture = Gesture.TAP;
+                movePointer();
+                view.postDelayed(longPress, ViewConfiguration.getLongPressTimeout());
+                break;
+            case MotionEvent.ACTION_POINTER_DOWN:
+                view.removeCallbacks(longPress);
+                if (gesture == Gesture.TAP || gesture == Gesture.DRAG) {
+                    releaseLeft();
+                    int primary = event.findPointerIndex(primaryId);
+                    if (primary >= 0 && event.getPointerCount() == 2) {
+                        secondId = event.getPointerId(index);
+                        lastScrollY = (event.getY(primary) + event.getY(index)) * 0.5f;
+                        scrollRemainder = 0;
+                        gesture = Gesture.SCROLL;
+                        break;
+                    }
+                }
+                gesture = Gesture.CONSUMED;
+                break;
+            case MotionEvent.ACTION_MOVE:
+                move(event);
+                break;
+            case MotionEvent.ACTION_POINTER_UP:
+                view.removeCallbacks(longPress);
+                releaseLeft();
+                gesture = Gesture.CONSUMED;
+                break;
+            case MotionEvent.ACTION_UP:
+                if (gesture == Gesture.TAP || gesture == Gesture.DRAG) {
+                    move(event);
+                    if (gesture == Gesture.TAP && view.mapDirectPoint(event.getX(index), event.getY(index), desktopPoint)) {
+                        movePointer();
+                        if (view.isPointerButtonLeftEnabled()) click(Pointer.Button.BUTTON_LEFT);
+                    }
+                }
+                cancel();
+                break;
+            case MotionEvent.ACTION_CANCEL:
+                cancel();
+                break;
+        }
+    }
+
+    private void move(MotionEvent event) {
+        int primary = event.findPointerIndex(primaryId);
+        if (primary < 0) return;
+        if (gesture == Gesture.SCROLL) {
+            int second = event.findPointerIndex(secondId);
+            if (second < 0) return;
+            float centerY = (event.getY(primary) + event.getY(second)) * 0.5f;
+            scrollRemainder += centerY - lastScrollY;
+            lastScrollY = centerY;
+            while (Math.abs(scrollRemainder) >= scrollStep) {
+                boolean scrollUp = scrollRemainder > 0;
+                click(scrollUp ? Pointer.Button.BUTTON_SCROLL_UP : Pointer.Button.BUTTON_SCROLL_DOWN);
+                scrollRemainder += scrollUp ? -scrollStep : scrollStep;
+            }
+            return;
+        }
+
+        float x = event.getX(primary);
+        float y = event.getY(primary);
+        if (gesture == Gesture.TAP && Math.hypot(x - startX, y - startY) > touchSlop) {
+            view.removeCallbacks(longPress);
+            gesture = Gesture.DRAG;
+            if (view.isPointerButtonLeftEnabled() && !server.pointer.isButtonPressed(Pointer.Button.BUTTON_LEFT)) {
+                view.mapDirectPoint(startX, startY, desktopPoint);
+                movePointer();
+                server.injectPointerButtonPress(Pointer.Button.BUTTON_LEFT);
+                leftDown = true;
+            }
+        }
+        if (gesture == Gesture.DRAG) {
+            view.mapDirectPoint(x, y, desktopPoint);
+            movePointer();
+        }
+    }
+
+    private void rightClick() {
+        if (gesture != Gesture.TAP || !view.isEnabled() || !view.isPointerButtonRightEnabled()) return;
+        if (view.mapDirectPoint(startX, startY, desktopPoint)) {
+            movePointer();
+            click(Pointer.Button.BUTTON_RIGHT);
+        }
+        gesture = Gesture.CONSUMED;
+    }
+
+    private void click(Pointer.Button button) {
+        if (!server.pointer.isButtonPressed(button)) {
+            server.injectPointerButtonPress(button);
+            server.injectPointerButtonRelease(button);
+        }
+    }
+
+    private void movePointer() {
+        server.injectPointerMove((int)desktopPoint[0], (int)desktopPoint[1]);
+    }
+
+    private void releaseLeft() {
+        if (leftDown) {
+            server.injectPointerButtonRelease(Pointer.Button.BUTTON_LEFT);
+            leftDown = false;
+        }
+    }
+
+    void cancel() {
+        view.removeCallbacks(longPress);
+        releaseLeft();
+        gesture = Gesture.IDLE;
+    }
+}
